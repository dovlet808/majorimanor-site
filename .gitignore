# Real configuration — never committed. config.example.php is.
/private/config.php

# Runtime logs, rate-limit state and the letters tools/mail_preview.php writes.
/private/logs/*
!/private/logs/.gitkeep

# Build output of deploy/build_release*.sh — the zips and the staged trees.
# deploy/private/config.php would carry the real mail password.
/deploy/*.zip
/deploy/public_html/
/deploy/private/
/deploy/parts/

# Source masters — camera originals, the client's concept renders, logo files.
# Some 600 MB, and the client's property: the built assets under
# public_html/assets/ are the deliverable and those are committed.
/media_src/

# Brand pipeline intermediates, regenerated by tools/brand/fix_caron.py.
/tools/brand/masters/

# Rendered page snapshots (tools/snapshot_pages.sh) and review captures —
# regenerated on demand, never a source of truth.
/.snapshots/
/captures/

# Python bytecode from the media build scripts.
__pycache__/

# OS noise
.DS_Store
Thumbs.db
